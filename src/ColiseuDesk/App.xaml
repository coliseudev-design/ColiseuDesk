<Application x:Class="ColiseuDesk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="ColiseuPrimaryBrush" Color="#0072BF"/>
        <SolidColorBrush x:Key="ColiseuSecondaryBrush" Color="#0094D2"/>
        <SolidColorBrush x:Key="ColiseuDarkBrush" Color="#4C4C4C"/>
        <SolidColorBrush x:Key="ColiseuBgBrush" Color="#F3F6FA"/>
    </Application.Resources>
</Application>
