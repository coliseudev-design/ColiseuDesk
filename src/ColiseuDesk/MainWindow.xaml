<Window x:Class="ColiseuDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ColiseuDesk - Coliseu Sistemas"
        Width="1040" Height="680"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Barra de Múltiplas Abas estilo AnyDesk -->
            <RowDefinition Height="38"/>
            <!-- Row 1: Barra de Ferramentas de Sessão Remota estilo AnyDesk -->
            <RowDefinition Height="44"/>
            <!-- Row 2: Conteúdo Principal (Painel Coliseu Sistemas) -->
            <RowDefinition Height="*"/>
            <!-- Row 3: Rodapé de Status -->
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: BARRA DE MÚLTIPLAS ABAS (ESTILO ANYDESK) ==================== -->
        <Border Grid.Row="0" Background="#E4E9F0" BorderBrush="#CFD8E3" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Aba Fixa: Nova Sessão -->
                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="6,6,0,0" Padding="14,7" Margin="0,4,4,0" BorderBrush="#CFD8E3" BorderThickness="1,1,1,0" Cursor="Hand" MouseLeftButtonUp="FocusRemoteInput_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/icon.png" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Nova Sessão" FontWeight="SemiBold" Foreground="#0072BF" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Lista Dinâmica de Múltiplas Abas de Clientes Conectados + Botão [+] -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <ItemsControl x:Name="SessionTabsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#DCE3EC" CornerRadius="6,6,0,0" Padding="10,6" Margin="0,6,4,0" BorderBrush="#C5D0DC" BorderThickness="1,1,1,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Tag="{Binding}" Click="SelectSessionTab_Click" ToolTip="Reconectar ou focar nesta sessão">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🖥" Foreground="#0072BF" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding}" Foreground="#222222" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Content="✕" Background="Transparent" BorderThickness="0" Foreground="#666666" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" Padding="3,0" Cursor="Hand" Tag="{Binding}" Click="CloseSessionTab_Click" ToolTip="Fechar aba"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Botão + Nova Conexão -->
                    <Button Content="+" Width="28" Height="26" Margin="2,6,0,0" Background="Transparent" BorderThickness="0" FontSize="16" FontWeight="Bold" Foreground="#4C4C4C" Cursor="Hand" ToolTip="Abrir mais uma conexão simultânea" Click="FocusRemoteInput_Click"/>
                </StackPanel>

                <!-- Selo Corporativo Limpo no Topo Direito -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E8F5E9" BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="12" Padding="12,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#1B873F" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TopVpsBadge" Text="Rede Coliseu Sistemas Online • Conexão Criptografada" FontSize="11.5" Foreground="#1B5E20" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ROW 1: BARRA DE FERRAMENTAS E PREFERÊNCIAS DE SESSÃO ==================== -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#D8E0EA" BorderThickness="0,0,0,1" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status de Conexão Segura -->
                <Border Grid.Column="0" Background="#E8F5E9" CornerRadius="4" Padding="7,4" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Conectado à rede Coliseu Sistemas">
                    <TextBlock Text="✔" Foreground="#1B873F" FontWeight="Bold" FontSize="13"/>
                </Border>

                <!-- Campo de Endereço Remoto na Barra Superior -->
                <Border Grid.Column="1" Background="White" BorderBrush="#BFCBD9" BorderThickness="1" CornerRadius="4" Height="32" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🖥" Foreground="#0072BF" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox x:Name="ToolbarRemoteIdBox" Grid.Column="1" Text="" BorderThickness="0" VerticalContentAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="#222222" ToolTip="Digite o ID do computador remoto" KeyDown="ToolbarRemoteIdBox_KeyDown"/>
                        <Button Grid.Column="2" Content="➔" Width="30" Background="#0072BF" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" ToolTip="Conectar agora" Click="ConnectFromToolbar_Click"/>
                    </Grid>
                </Border>

                <!-- Controles Reais de Sessão e Preferências -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="BtnFocusActiveWindow" Content="🖥 Focar Janela Ativa" Height="28" Padding="10,0" Margin="2,0,6,0" Background="#E8F4FC" Foreground="#0072BF" FontWeight="SemiBold" FontSize="11.5" BorderBrush="#B8DDF8" BorderThickness="1" Cursor="Hand" ToolTip="Trazer a janela da sessão remota ativa para frente (a troca de Monitor 1/2 fica no topo da janela do cliente conectado)" Click="FocusSessionWindow_Click"/>

                    <Button Content="📂 Arquivos" Height="28" Padding="10,0" Margin="2,0,6,0" Background="White" Foreground="#333333" FontWeight="SemiBold" FontSize="11.5" BorderBrush="#D0D7DE" BorderThickness="1" Cursor="Hand" ToolTip="Abrir Transferência de Arquivos com o ID preenchido" Click="FileTransferFromToolbar_Click"/>

                    <Button x:Name="BtnQualityToggle" Content="🎨 Imagem: Alta" Height="28" Padding="10,0" Margin="2,0,6,0" Background="White" Foreground="#333333" FontSize="11.5" BorderBrush="#D0D7DE" BorderThickness="1" Cursor="Hand" ToolTip="Alternar qualidade de imagem das sessões (Alta / Balanceada / Rápida)" Click="ToggleImageQuality_Click"/>

                    <Button x:Name="BtnAudioToggle" Content="🔊 Som: Ativo" Height="28" Padding="10,0" Margin="2,0,6,0" Background="White" Foreground="#333333" FontSize="11.5" BorderBrush="#D0D7DE" BorderThickness="1" Cursor="Hand" ToolTip="Ativar ou silenciar transmissão de áudio remoto" Click="ToggleAudio_Click"/>

                    <Button x:Name="BtnClipboardToggle" Content="📋 Ctrl+C/V: Ativo" Height="28" Padding="10,0" Margin="2,0" Background="White" Foreground="#333333" FontSize="11.5" BorderBrush="#D0D7DE" BorderThickness="1" Cursor="Hand" ToolTip="Ativar ou desativar sincronização da área de transferência" Click="ToggleClipboard_Click"/>
                </StackPanel>

                <!-- Botão Pasta de Gravações -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🎬 Pasta de Gravações" Height="28" Padding="10,0" Margin="2,0" Background="White" BorderBrush="#D0D7DE" BorderThickness="1" Foreground="#4C4C4C" FontSize="11.5" Cursor="Hand" ToolTip="Abrir pasta local onde as gravações de sessão são salvas" Click="OpenRecordingsFolder_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ROW 2: PAINEL PRINCIPAL COLISEU SISTEMAS ==================== -->
        <Grid Grid.Row="2" Margin="22,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CARD ESQUERDO: ESTE COMPUTADOR (ID E SENHA DO CLIENTE) -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#DCE3EC" BorderThickness="1" Padding="24,18">
                <StackPanel>
                    <!-- Logo Oficial Coliseu Sistemas Grande Preenchida -->
                    <Image Source="pack://application:,,,/Assets/logo-coliseu.png" HorizontalAlignment="Stretch" Stretch="Uniform" MaxHeight="95" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality"/>

                    <TextBlock Text="Este Computador (Receber Suporte)" FontSize="15" FontWeight="Bold" Foreground="#222222"/>
                    <TextBlock Text="Informe o ID e a senha abaixo ao suporte da Coliseu Sistemas para autorizar o atendimento remoto." FontSize="12" Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,16"/>

                    <!-- Box do ID de 9 Dígitos -->
                    <Border Background="#F0F7FF" BorderBrush="#0072BF" BorderThickness="1.5" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SEU ID COLISEUDESK" FontSize="10.5" FontWeight="Bold" Foreground="#0072BF"/>
                                <TextBlock x:Name="LocalIdText" Text="Sincronizando..." FontSize="26" FontWeight="Bold" Foreground="#004C80" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnCopyId" Grid.Column="1" Content="📋 Copiar" VerticalAlignment="Center" Background="#0072BF" Foreground="White" BorderThickness="0" Padding="12,7" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Click="CopyLocalId_Click"/>
                        </Grid>
                    </Border>

                    <!-- Box de Senha Temporária -->
                    <Border Background="#F8FAFC" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SENHA TEMPORÁRIA DE SESSÃO" FontSize="10.5" FontWeight="Bold" Foreground="#666666"/>
                                <TextBlock x:Name="TempPasswordText" Text="......" FontSize="20" FontWeight="Bold" Foreground="#333333" FontFamily="Consolas" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🔄" Width="32" Height="30" Margin="0,0,6,0" Background="White" BorderBrush="#CFD8E3" BorderThickness="1" Cursor="Hand" ToolTip="Gerar nova senha temporária" Click="RegeneratePassword_Click"/>
                                <Button x:Name="BtnCopyPwd" Content="Copiar" Background="White" BorderBrush="#CFD8E3" BorderThickness="1" Padding="10,5" FontSize="12" Cursor="Hand" Click="CopyPassword_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Acesso Não Supervisionado (Senha Fixa) -->
                    <Border Background="#F4F7FA" CornerRadius="8" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="🔑 Acesso Permanente (Senha Fixa)" FontWeight="SemiBold" FontSize="13" Foreground="#333333"/>
                            <TextBlock Text="Opcional: defina uma senha fixa para permitir o acesso rápido sem confirmação manual." FontSize="11.5" Foreground="#666666" TextWrapping="Wrap" Margin="0,3,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="FixedPasswordBox" Grid.Column="0" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="Definir Senha" Background="#0094D2" Foreground="White" BorderThickness="0" Padding="12,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Click="SaveFixedPassword_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- CARD DIREITO: DAR SUPORTE A UM CLIENTE (MÚLTIPLAS SESSÕES SIMULTÂNEAS) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Painel Superior Direito: Conectar a outro Computador -->
                <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="#DCE3EC" BorderThickness="1" Padding="24,18">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Acessar Outro Computador (Multi-Sessão)" FontSize="16" FontWeight="Bold" Foreground="#0072BF"/>
                                <TextBlock Text="Digite o ID ColiseuDesk de 9 dígitos. Você pode abrir quantas conexões simultâneas quiser ao mesmo tempo." FontSize="12" Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,14"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#E8F4FC" CornerRadius="6" Padding="10,4" VerticalAlignment="Top">
                                <TextBlock Text="🔒 Sessões Ilimitadas" FontSize="11" FontWeight="Bold" Foreground="#0072BF"/>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="MainRemoteIdBox" Grid.Column="0" Text="" Height="42" FontSize="18" FontWeight="Bold" VerticalContentAlignment="Center" Padding="12,0" BorderBrush="#0072BF" BorderThickness="1.5" ToolTip="Digite o ID de 9 dígitos" KeyDown="MainRemoteIdBox_KeyDown"/>

                            <Button Grid.Column="1" Content="⚡ Conectar" Height="42" Margin="10,0,0,0" Padding="22,0" Background="#0072BF" Foreground="White" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="ConnectMain_Click"/>

                            <Button Grid.Column="2" Content="📂 Transferir Arquivos" Height="42" Margin="8,0,0,0" Padding="16,0" Background="#0094D2" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="SemiBold" Cursor="Hand" Click="FileTransferMain_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Painel Inferior Direito: Computadores Recentes / Favoritos -->
                <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#DCE3EC" BorderThickness="1" Padding="24,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Conexões Recentes e Favoritos" FontSize="14" FontWeight="Bold" Foreground="#333333"/>
                            <Button Grid.Column="1" Content="+ Salvar / Nomear ID" Background="Transparent" BorderBrush="#0072BF" BorderThickness="1" Foreground="#0072BF" Padding="10,3" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Click="AddFavoriteClient_Click"/>
                        </Grid>

                        <StackPanel x:Name="EmptyHistoryPlaceholder" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🖥" FontSize="32" HorizontalAlignment="Center" Foreground="#BFCBD9" Margin="0,0,0,6"/>
                            <TextBlock Text="Nenhuma conexão recente realizada a partir deste computador." FontSize="13" Foreground="#777777" HorizontalAlignment="Center"/>
                            <TextBlock Text="Os computadores que você acessar aparecerão listados aqui para conexão rápida." FontSize="11.5" Foreground="#999999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <ListBox x:Name="ClientsListBox" Grid.Row="1" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" MouseDoubleClick="ClientsListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E4E9F0" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6" Background="#E0F2FE" Margin="0,0,12,0">
                                                <TextBlock Text="🖥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0072BF"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" Foreground="#222222"/>
                                                    <TextBlock Text=" • " Foreground="#999999"/>
                                                    <TextBlock Text="{Binding Company}" FontSize="12.5" Foreground="#0072BF" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="ID: " FontSize="12" Foreground="#666666"/>
                                                    <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="Bold" Foreground="#444444"/>
                                                    <TextBlock Text="   |   Último acesso: " FontSize="11.5" Foreground="#888888"/>
                                                    <TextBlock Text="{Binding LastConnected}" FontSize="11.5" Foreground="#888888"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="✏" Tag="{Binding Id}" VerticalAlignment="Center" Background="White" Foreground="#555555" BorderBrush="#D0D7DE" BorderThickness="1" Padding="8,6" Margin="0,0,6,0" FontSize="11.5" Cursor="Hand" ToolTip="Renomear cliente / empresa" Click="EditSavedClient_Click"/>
                                            <Button Grid.Column="3" Content="🗑" Tag="{Binding Id}" VerticalAlignment="Center" Background="White" Foreground="#C62828" BorderBrush="#D0D7DE" BorderThickness="1" Padding="8,6" Margin="0,0,6,0" FontSize="11.5" Cursor="Hand" ToolTip="Remover da lista" Click="DeleteSavedClient_Click"/>
                                            <Button Grid.Column="4" Content="📂 Arquivos" Tag="{Binding Id}" VerticalAlignment="Center" Background="#F0F7FF" Foreground="#0072BF" BorderBrush="#BFCBD9" BorderThickness="1" Padding="10,6" Margin="0,0,6,0" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Click="FileTransferSavedClient_Click"/>
                                            <Button Grid.Column="5" Content="Conectar" Tag="{Binding Id}" VerticalAlignment="Center" Background="#0072BF" Foreground="White" BorderThickness="0" Padding="14,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Click="ConnectSavedClient_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== ROW 3: BARRA DE STATUS INFERIOR ==================== -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#DCE3EC" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#1B873F" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusTextBlock" Text="Pronto para conexões (Rede Coliseu Sistemas Online)" FontSize="12" Foreground="#444444"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="ColiseuDesk v1.1 • Coliseu Sistemas" FontSize="11.5" Foreground="#888888" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ==================== MODAL DE EDIÇÃO DE CLIENTE FAVORITO ==================== -->
        <Grid x:Name="ClientModalOverlay" Grid.RowSpan="4" Background="#66000000" Visibility="Collapsed">
            <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Background="White" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="10" Padding="24,20">
                <StackPanel>
                    <TextBlock Text="⭐ Identificar Computador do Cliente" FontSize="15.5" FontWeight="Bold" Foreground="#0072BF"/>
                    <TextBlock Text="Defina um nome amigável e a empresa para localizar rapidamente este computador na lista." FontSize="12" Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,14"/>

                    <TextBlock Text="ID ColiseuDesk:" FontWeight="SemiBold" FontSize="12" Foreground="#333333"/>
                    <TextBox x:Name="ClientModalIdBox" Height="32" Margin="0,4,0,10" Padding="8,0" VerticalContentAlignment="Center" FontSize="13.5" FontWeight="Bold"/>

                    <TextBlock Text="Nome do Terminal / Setor (ex: Caixa 01, Recepção):" FontWeight="SemiBold" FontSize="12" Foreground="#333333"/>
                    <TextBox x:Name="ClientModalNameBox" Height="32" Margin="0,4,0,10" Padding="8,0" VerticalContentAlignment="Center" FontSize="13"/>

                    <TextBlock Text="Empresa / Cliente:" FontWeight="SemiBold" FontSize="12" Foreground="#333333"/>
                    <TextBox x:Name="ClientModalCompanyBox" Height="32" Margin="0,4,0,16" Padding="8,0" VerticalContentAlignment="Center" FontSize="13"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Width="100" Height="34" Margin="0,0,10,0" Background="#E4E9F0" Foreground="#333333" BorderThickness="0" Cursor="Hand" Click="CloseClientModal_Click"/>
                        <Button Content="Salvar Cliente" Width="130" Height="34" Background="#0072BF" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="SaveClientModal_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== PAINEL TÉCNICO OCULTO (Apenas via atalho secreto Ctrl+Shift+F12) ==================== -->
        <Grid x:Name="VpsModalOverlay" Grid.RowSpan="4" Background="#88000000" Visibility="Collapsed">
            <Border Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Background="White" CornerRadius="10" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="🔧 Painel Técnico Interno — Coliseu Sistemas" FontSize="16" FontWeight="Bold" Foreground="#0072BF"/>
                    <TextBlock Text="Configuração interna de infraestrutura (oculta para clientes finais)." FontSize="12" Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,16"/>

                    <TextBlock Text="Servidor de Conexão (Host):" FontWeight="SemiBold" FontSize="12.5" Foreground="#333333"/>
                    <TextBox x:Name="VpsHostInput" Height="34" Margin="0,4,0,12" Padding="8,0" VerticalContentAlignment="Center" FontSize="13"/>

                    <TextBlock Text="Chave Pública (Ed25519):" FontWeight="SemiBold" FontSize="12.5" Foreground="#333333"/>
                    <TextBox x:Name="VpsKeyInput" Height="34" Margin="0,4,0,16" Padding="8,0" VerticalContentAlignment="Center" FontSize="13" FontFamily="Consolas"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Fechar" Width="100" Height="34" Margin="0,0,10,0" Background="#E4E9F0" Foreground="#333333" BorderThickness="0" Cursor="Hand" Click="CloseVpsModal_Click"/>
                        <Button Content="Salvar" Width="140" Height="34" Background="#0072BF" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="SaveVpsConfig_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
