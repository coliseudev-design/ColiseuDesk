<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>ColiseuDesk</AssemblyName>
    <RootNamespace>ColiseuDesk</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Version>1.0.0</Version>
    <Company>Coliseu Sistemas</Company>
    <Product>ColiseuDesk - Acesso Remoto</Product>
    <Description>ColiseuDesk - Plataforma de Suporte e Acesso Remoto da Coliseu Sistemas</Description>
    <Copyright>Copyright © 2026 Coliseu Sistemas</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo-coliseu.png" />
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

</Project>
